conky.config = {
    -- Position & Size
    alignment = 'top_right',
    gap_x = 5,
    gap_y = 40,
    minimum_width = 460,
    maximum_width = 460,

    -- Window
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 230,
    own_window_colour = '#1a1a1a',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    -- Borders & Drawing
    border_width = 0,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    stippled_borders = 0,

    -- Font
    use_xft = true,
    xftalpha = 1,
    font = 'DejaVu Sans Mono:size=12',

    -- Behavior
    background = true,
    double_buffer = true,
    no_buffers = true,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    update_interval = 2.0,
    uppercase = false,
    use_spacer = 'none',
    extra_newline = false,
    short_units = true,
    max_user_text = 65536,

    -- Output
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,

    -- Colors
    default_color = '#c8c8c8',
    color1 = '#ef5350',
    color2 = '#d32f2f',
    color3 = '#808080',
    color4 = '#81d4fa',
    color5 = '#ff6659',
    color6 = '#66cc66',
}

conky.text = [[
${color1}${font DejaVu Sans Mono:bold:size=31}${time %H:%M:%S}${font}${color}${alignr}${color3}${font DejaVu Sans Mono:size=15}${time %A}${font}${color}
${color4}${font DejaVu Sans Mono:size=15}${time %Y-%m-%d}${font}${color}${alignr}${color3}${font Noto Sans CJK SC:size=12}${execi 3600 python3 /nv/cpp/conky-forge/scripts/lunar.py}${font}${color}
${color3}${hr 1}${color}
${color1}${font DejaVu Sans Mono:bold:size=15}SYSTEM${font}${color}
${color3}${hr 1}${color}
${color3}Host${color}${goto 132}${nodename}
${color3}OS${color}${goto 132}${execi 3600 lsb_release -ds 2>/dev/null || grep PRETTY_NAME /etc/os-release | cut -d'"' -f2}
${color3}Kernel${color}${goto 132}${kernel}
${color3}Uptime${color}${goto 132}${color4}${uptime}${color}
${color3}Load${color}${goto 132}${color4}${loadavg}${color}
${color3}Processes${color}${goto 132}${color4}${processes}${color} total${goto 314}${color4}${running_processes}${color} running
${color3}RAM${color}${goto 132}${if_match ${memperc} > 80}${color5}${else}${if_match ${memperc} > 30}${color4}${else}${color6}${endif}${endif}${mem} / ${memmax}${alignr}${memperc}%${color}
${color3}${membar 10}${color}
${color3}Public IP${color}${goto 132}${execi 300 curl -s --max-time 5 ifconfig.me}
${voffset 6}${color1}${font DejaVu Sans Mono:bold:size=15}CPU${font}${color}  ${color3}${font DejaVu Sans Mono:size=10}Intel Core i9-7960X @ 2.80GHz  16C/32T${font}${color}
${color3}${hr 1}${color}
${color3}Total${color}${goto 132}${if_match ${cpu cpu0} > 80}${color5}${else}${if_match ${cpu cpu0} > 30}${color4}${else}${color6}${endif}${endif}${cpu cpu0}%${color}${goto 254}${color3}Core 12${color}${goto 326}${if_match ${hwmon 4 temp 14} > 76}${color5}${else}${if_match ${hwmon 4 temp 14} > 30}${color4}${else}${color6}${endif}${endif}${hwmon 4 temp 14}°C${color}
